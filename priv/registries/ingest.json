{
  "inbox_ignore": {
    "names": [".DS_Store", "Thumbs.db", "ehthumbs.db", "desktop.ini", ".localized", ".directory"],
    "prefixes": ["._", ".~lock.", ".syncthing."],
    "suffixes": [".part", ".crdownload", ".download", ".partial", ".opdownload", ".!qB", ".tmp"],
    "directories": ["@eaDir", ".Trashes", ".Spotlight-V100", ".fseventsd", "$RECYCLE.BIN", ".stfolder"]
  },
  "companions": [
    {
      "kind": "cover_art",
      "base_names": ["cover", "folder", "front", "albumart", "albumartsmall", "album"],
      "extensions": ["jpg", "jpeg", "png", "webp", "gif", "bmp"]
    },
    {"kind": "lyrics", "extensions": ["lrc"]},
    {"kind": "cue_sheet", "extensions": ["cue"]},
    {"kind": "description", "extensions": ["nfo"]}
  ],
  "codecs": {
    "flac": "lossless",
    "alac": "lossless",
    "ape": "lossless",
    "tta": "lossless",
    "mlp": "lossless",
    "truehd": "lossless",
    "shorten": "lossless",
    "mp3": "lossy",
    "mp2": "lossy",
    "aac": "lossy",
    "vorbis": "lossy",
    "opus": "lossy",
    "ac3": "lossy",
    "eac3": "lossy",
    "wmav1": "lossy",
    "wmav2": "lossy",
    "amr_nb": "lossy",
    "amr_wb": "lossy",
    "dts": {"parameter": "profile", "cases": {"DTS-HD MA": "lossless", "DTS-HD MA + DTS:X": "lossless", "DTS-HD MA + DTS:X IMAX": "lossless", "DTS": "lossy", "DTS-ES": "lossy", "DTS 96/24": "lossy", "DTS-HD HRA": "lossy", "DTS Express": "lossy"}},
    "wavpack": {"parameter": "profile", "cases": {}},
    "ffv1": "lossless",
    "huffyuv": "lossless",
    "ffvhuff": "lossless",
    "utvideo": "lossless",
    "rawvideo": "lossless",
    "qtrle": "lossless",
    "png": "lossless",
    "apng": "lossless",
    "gif": "lossless",
    "bmp": "lossless",
    "tiff": "lossless",
    "mjpeg": "lossy",
    "mpeg1video": "lossy",
    "mpeg2video": "lossy",
    "mpeg4": "lossy",
    "msmpeg4v3": "lossy",
    "vp8": "lossy",
    "prores": "lossy",
    "dnxhd": "lossy",
    "theora": "lossy",
    "wmv3": "lossy",
    "vc1": "lossy",
    "h264": {"parameter": "profile", "cases": {"High 4:4:4 Predictive": "unknown", "High 4:4:4 Intra": "unknown"}, "otherwise": "lossy"},
    "hevc": {"parameter": "profile", "cases": {}},
    "vp9": {"parameter": "profile", "cases": {}},
    "av1": {"parameter": "profile", "cases": {}},
    "webp": {"parameter": "profile", "cases": {}},
    "jpegxl": {"parameter": "profile", "cases": {}},
    "jpeg2000": {"parameter": "profile", "cases": {}},
    "subrip": "lossless",
    "ass": "lossless",
    "ssa": "lossless",
    "webvtt": "lossless",
    "mov_text": "lossless",
    "text": "lossless",
    "hdmv_pgs_subtitle": "lossless",
    "dvd_subtitle": "lossless",
    "dvb_subtitle": "lossless"
  },
  "codec_prefixes": {
    "pcm_": "lossless"
  },
  "image_containers": ["png_pipe", "jpeg_pipe", "bmp_pipe", "tiff_pipe", "webp_pipe", "gif", "gif_pipe", "jpegxl_pipe", "j2k_pipe", "image2"],
  "streamless_formats": {
    "x-fmt/111": {"class": "text", "essence": "not_applicable"},
    "fmt/14": {"class": "text", "essence": "not_applicable"},
    "fmt/15": {"class": "text", "essence": "not_applicable"},
    "fmt/16": {"class": "text", "essence": "not_applicable"},
    "fmt/17": {"class": "text", "essence": "not_applicable"},
    "fmt/18": {"class": "text", "essence": "not_applicable"},
    "fmt/19": {"class": "text", "essence": "not_applicable"},
    "fmt/20": {"class": "text", "essence": "not_applicable"},
    "fmt/276": {"class": "text", "essence": "not_applicable"},
    "fmt/95": {"class": "text", "essence": "not_applicable"},
    "fmt/354": {"class": "text", "essence": "not_applicable"},
    "fmt/476": {"class": "text", "essence": "not_applicable"},
    "fmt/477": {"class": "text", "essence": "not_applicable"},
    "fmt/478": {"class": "text", "essence": "not_applicable"},
    "fmt/479": {"class": "text", "essence": "not_applicable"},
    "fmt/480": {"class": "text", "essence": "not_applicable"},
    "fmt/481": {"class": "text", "essence": "not_applicable"},
    "fmt/483": {"class": "text", "essence": "not_applicable"},
    "fmt/1069": {"class": "text", "essence": "not_applicable"}
