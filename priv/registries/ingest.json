  "categories": {
    "companion": {"cover_art": "cover_art", "lyrics": "lyrics", "cue_sheet": "cue_sheet", "description": "description"},
    "audio": "music_recording",
    "video": "home_video",
    "image": "photograph",
    "text": "document",
    "release": "album"
  },
  "standard_formats": {
    "audio": {"codec": "flac", "muxer": "flac", "extension": "flac", "format": "fmt/279"}
  }
}
