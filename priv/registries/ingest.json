  "category_evidence": [
    {
      "tag": "genre",
      "classes": ["audio"],
      "values": {
        "audiobook": "audiobook",
        "podcast": "podcast_episode"
      },
      "for": "the genre a distributor set and a tagger wrote. Matched whole and case-folded, so 'Audiobook' decides and 'Audiobooks & Spoken Word' does not"
    }
  ],
  "byte_signatures": [
    {
      "format": "ines",
      "offset": 0,
      "hex": "4e45531a",
      "for": "an NES cartridge dump in the iNES container"
    },
    {
      "format": "megadrive",
      "offset": 256,
      "hex": "5345474120",
      "for": "a Mega Drive or Genesis cartridge dump, whose header says SEGA at 0x100"
    },
    {
      "format": "n64",
      "offset": 0,
      "hex": "80371240",
      "for": "an N64 cartridge dump in big-endian byte order"
    },
    {
      "format": "iso9660",
      "offset": 32769,
      "hex": "4344303031",
      "for": "a disc image, whose primary volume descriptor says CD001 at 0x8001"
    },
    {
      "format": "unif",
      "offset": 0,
      "hex": "554e4946",
      "for": "an NES cartridge dump in the UNIF container, which says UNIF at 0x0"
    },
    {
      "format": "gba",
      "offset": 4,
      "hex": "24ffae51699aa221",
      "for": "a Game Boy Advance cartridge dump, whose fixed Nintendo logo begins at 0x4 and which the console refuses to boot without"
    },
    {
      "format": "gameboy",
      "offset": 260,
      "hex": "ceed6666cc0d000b",
      "for": "a Game Boy or Game Boy Color cartridge dump, whose fixed Nintendo logo begins at 0x104. One signature serves both: the logo is identical and the colour flag at 0x143 distinguishes them, which says nothing about the broad class"
    }
  ]
}
