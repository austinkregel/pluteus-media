FROM hexpm/elixir:1.19.5-erlang-28.3.3-debian-bookworm-20260824-slim

# build-essential and git build native dependencies (lazy_html ships a NIF, and
# the analysis layer will add more). inotify-tools backs Phoenix live reload;
# without it file_system falls back to polling and code reloading stops working
# across the bind mount.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential git inotify-tools \
    && rm -rf /var/lib/apt/lists/*

# Siegfried identifies formats against PRONOM from the bytes themselves
# (spec-03 §6). Debian does not package it, so the upstream release is fetched
# by exact version and refused unless its digest matches.
ARG SIEGFRIED_VERSION=1.11.8
ARG SIEGFRIED_SHA256=667a61c80a9e0249b54c463c63d6a87b2c1da75f3e0dc126e648f15663d43ae9
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && curl -fsSL -o /tmp/siegfried.deb \
       "https://github.com/richardlehane/siegfried/releases/download/v${SIEGFRIED_VERSION}/siegfried_${SIEGFRIED_VERSION}-1_amd64.deb" \
    && echo "${SIEGFRIED_SHA256}  /tmp/siegfried.deb" | sha256sum -c - \
    && apt-get install -y --no-install-recommends /tmp/siegfried.deb \
    && rm /tmp/siegfried.deb \
    && apt-get purge -y curl \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# ffprobe reads a container's streams, codecs, dispositions and tags, which
# identification decides essence and media class from (spec-04 §5). ffmpeg is
# the normalizing encoder and builds the media the tests ingest.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# [spec-10] §11.5's text artefacts and §11.2's tiled pyramid.
#
# poppler-utils extracts a publication's text and its per-word positions, which are
# the substrate for search and for anchoring an annotation to a phrase. tesseract-ocr
# does the same for a scan, where the text is in the pixels rather than in the file;
# its English data is the only language pack installed, and a household holding
# another adds that pack rather than changing this.
#
# libvips reads and writes a tiled pyramid without holding the whole image, which is
# what makes a 600dpi scan tileable at all: ffmpeg would decode the full frame per
# tile, and above §20's threshold that is gigabytes per request.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       poppler-utils tesseract-ocr tesseract-ocr-eng libvips-tools \
    && rm -rf /var/lib/apt/lists/*

# libarchive lists and extracts a comic archive's entries, which is what says a ZIP or a
# RAR of page images is a comic at all. spec-04 §5 identifies the container from its bytes
# and a container's bytes say nothing about what it holds: a .cbz is any ZIP and a .cbr is
# any RAR, so classification corroborates from the entries and spec-10 §12.1's page reader
# extracts page n from them.
#
# Its RAR readers are clean-room BSD-2-Clause work in Debian main, and they read RAR 5.0,
# which is what the household's own comics are. The non-free `unrar` is not needed: the
# unRAR licence restricts writing a compressor rather than reading one.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libarchive-tools \
    && rm -rf /var/lib/apt/lists/*

RUN mix local.hex --force && mix local.rebar --force

WORKDIR /app

CMD ["mix", "phx.server"]
