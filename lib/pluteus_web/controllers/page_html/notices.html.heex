<div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
  <.header>
    Third-party notices
    <:subtitle>
      The material vendored into this repository, and what each one's licence requires.
      A dependency the build resolves is not listed: its licence travels in its own
      package, while what is committed here is redistributed by this repository.
    </:subtitle>
  </.header>

  <article :for={notice <- @notices} class="mb-8 rounded-lg bg-surface-raised p-4">
    <h2 class="text-title-sm font-semibold text-on-surface-strong">
      {notice.name} {notice.version}
    </h2>
    <p class="mt-1 text-body-sm text-on-surface-muted">{notice.what}</p>
    <dl class="mt-3 flex flex-col gap-1 text-body-sm">
      <div class="flex gap-3">
        <dt class="w-20 shrink-0 text-on-surface-muted">Source</dt>
        <dd>
          <a class="text-on-surface-strong underline" href={notice.source}>{notice.source}</a>
        </dd>
      </div>
      <div class="flex gap-3">
        <dt class="w-20 shrink-0 text-on-surface-muted">Vendored</dt>
        <dd class="font-mono text-data text-on-surface-strong">{notice.vendored}</dd>
      </div>
    </dl>
    <pre class="mt-3 overflow-x-auto rounded-md bg-surface-base p-3 font-mono text-data whitespace-pre-wrap text-on-surface-strong">{notice.licence}</pre>
  </article>
</div>
