<!DOCTYPE html>
<html lang="en" {context_attributes(@contexts, @distance)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Pluteus">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      // Annex A.10.1's context attributes. Two are recorded per modifier — the
      // resolved value and the person's intent — so that "follow the system" is a
      // third state rather than a lost one. Inline and ahead of the body, because an
      // attribute written after the first paint is a flash of the wrong theme.
      //
      // A browser refusing site data throws on the first read here and nothing below
      // runs. That is the intended behaviour: what the server rendered stays on the
      // root, and where it rendered nothing the generated stylesheet's
      // `prefers-color-scheme`, `prefers-contrast` and `prefers-reduced-motion` queries
      // are what answers, which is why they exist.
      //
      // Where the server named a principal's intent, that is what this follows.
      // `localStorage` is then the carrier for a page with nobody signed in and for
      // `distance`, which spec-10 §4.4 records with the device — never for a preference
      // §14.5 makes one person's.
      (() => {
        // Each modifier that has a system signal, with the context its query means
        // and the context its absence means.
        const systems = {
          theme: ["(prefers-color-scheme: light)", "light", "dark"],
          contrast: ["(prefers-contrast: more)", "more", "normal"],
          motion: ["(prefers-reduced-motion: reduce)", "reduced", "full"]
        };

        // The token file's own default resolution for each modifier this script resolves.
        // A modifier absent from `systems` has no media feature to read, so its intent is
        // always an outright choice. §4.4 makes `distance` the device's declaration, which
        // the server renders.
        const defaults = {
          theme: "dark",
          contrast: "normal",
          motion: "full",
          density: "comfortable"
        };

        const root = document.documentElement;
        const key = (modifier) => `pluteus:${modifier}`;
        const modifiers = Object.keys(defaults);

        // The modifiers the server holds an intent for. It names them, so nothing here
        // decides which belong to the person and which to the device.
        const stored = new Set((root.dataset.stored || "").split(" ").filter(Boolean));

        // The modifiers §4.4 makes a declaration of the device's. The server renders them.
        const declared = new Set((root.dataset.declared || "").split(" ").filter(Boolean));

        // Read once, before anything below writes an attribute: `apply` writes these same
        // names, and reading them later would return whatever it had just put there.
        const intents = {};
        modifiers.forEach((modifier) => {
          const rendered = root.getAttribute(`data-${modifier}-intent`);
          if (rendered) intents[modifier] = rendered;
        });

        // A stored modifier never reads this browser's own key. That key is the device's
        // carrier — what someone chose here before the proxy named anybody — and on a
        // shared browser it is equally the last person's, which §14.5 forbids applying to
        // this one. It is left alone rather than removed: it is not this principal's to
        // store and not this principal's to destroy, and it is what answers again once
        // nobody is signed in.
        const intentOf = (modifier) =>
          intents[modifier] ||
          (stored.has(modifier) ? null : localStorage.getItem(key(modifier))) ||
          (systems[modifier] ? "system" : defaults[modifier]);

        const resolve = (modifier, intent) => {
          const system = systems[modifier];
          if (!system || intent !== "system") return intent;
          const [query, matched, otherwise] = system;
          return window.matchMedia(query).matches ? matched : otherwise;
        };

        const apply = (modifier) => {
          const intent = intentOf(modifier);
          root.setAttribute(`data-${modifier}`, resolve(modifier, intent));
          root.setAttribute(`data-${modifier}-intent`, intent);
          document.querySelectorAll(`[data-modifier="${modifier}"]`).forEach((button) => {
            button.setAttribute("aria-pressed", String(button.dataset.context === intent));
          });
        };

        modifiers.forEach(apply);

        // A system preference changing mid-session moves the resolved value without
        // touching the intent, which is the whole reason the two are separate.
        Object.entries(systems).forEach(([modifier, [query]]) => {
          window.matchMedia(query).addEventListener("change", () => apply(modifier));
        });

        window.addEventListener("storage", (event) => {
          const modifier = (event.key || "").replace(/^pluteus:/, "");
          if (modifiers.includes(modifier)) apply(modifier);
        });

        // A stored modifier's choice goes to the store and nowhere else. The page moves
        // first so the control answers the press at once, and moves back if the store
        // refuses: a control left showing a context that was never written would be
        // reporting a preference this person does not have.
        const persist = (modifier, context, previous) =>
          fetch("/preferences", {
            method: "PUT",
            headers: {"content-type": "application/json"},
            body: JSON.stringify({preferences: {[modifier]: context}})
          }).then((response) => {
            if (response.ok) return;
            if (previous) intents[modifier] = previous;
            else delete intents[modifier];
            apply(modifier);
            throw new Error(`${modifier} was not stored: ${response.status}`);
          });

        // A declaration is recorded with the device by a request, and the page is reloaded
        // to be drawn under it.
        const declare = (modifier, context) => {
          const token = document.querySelector("meta[name='csrf-token']").content;
          const body = new URLSearchParams({
            [modifier]: context,
            _csrf_token: token,
            return_to: location.pathname
          });

          fetch(`/${modifier}`, {
            method: "POST",
            headers: {"content-type": "application/x-www-form-urlencoded"},
            body
          }).then((response) => {
            if (!response.ok) throw new Error(`${modifier} was not declared: ${response.status}`);
            location.reload();
          });
        };

        document.addEventListener("click", (event) => {
          const button = event.target.closest("[data-modifier][data-context]");
          if (!button) return;
          const {modifier, context} = button.dataset;

          if (declared.has(modifier)) {
            declare(modifier, context);
          } else if (stored.has(modifier)) {
            const previous = intents[modifier];
            intents[modifier] = context;
            apply(modifier);
            persist(modifier, context, previous);
          } else {
            if (context === "system") localStorage.removeItem(key(modifier));
            else localStorage.setItem(key(modifier), context);
            apply(modifier);
          }
        });

        // The buttons do not exist when this runs, so their pressed state is set once
        // the document has them.
        document.addEventListener("DOMContentLoaded", () => modifiers.forEach(apply));
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
